{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://arco-publisher-api.thinht7110.workers.dev/v1/:path*" },
    { "source": "/media/:path*", "destination": "https://arco-publisher-api.thinht7110.workers.dev/media/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
